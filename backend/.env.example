# FastAPI Settings
SECRET_KEY=your-secret-key-here-change-in-production
ENCRYPTION_KEY=your-fernet-encryption-key-here

# Database
DATABASE_URL=sqlite+aiosqlite:///./navidrome_player.db

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Session
SESSION_EXPIRE_DAYS=30

# Navidrome Server Connection (Backend acts as proxy)
NAVIDROME_URL=http://localhost:4533
NAVIDROME_USER=skenls
NAVIDROME_PASS=your-navidrome-password
# Or precomputed Subsonic token and salt:
# NAVIDROME_TOKEN=...
# NAVIDROME_SALT=...

# Initial Admin Bootstrap (created automatically if no users exist in database)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin123
